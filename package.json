{
  "name": "training-platform-backend",
  "version": "1.0.0",
  "description": "Backend for training management platform",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "prepare": "node scripts/setup-git-filters.js",
    "build": "tsc && node -e \"const fs=require('fs'); fs.copyFileSync('src/infrastructure/database/schema.sql','dist/infrastructure/database/schema.sql'); fs.cpSync('src/infrastructure/services/emailTemplates','dist/infrastructure/services/emailTemplates',{recursive:true})\"",
    "start": "node dist/server.js",
    "dev": "nodemon --watch src --ext ts --exec ts-node src/server.ts",
    "db:migrate": "ts-node src/infrastructure/database/migrate.ts",
    "db:provision-roles": "ts-node scripts/provisionDbRoles.ts",
    "db:seed-superadmin": "ts-node scripts/seedSuperAdmin.ts",
    "db:seed-developer": "ts-node scripts/seedDeveloper.ts",
    "docs:export": "ts-node scripts/exportSwagger.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:unit": "cross-env NODE_OPTIONS=--experimental-vm-modules jest tests/unit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.13.12",
    "multer": "^2.3.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.19.1",
    "pg": "^8.23.0",
    "pm2": "^7.0.4",
    "qrcode": "^1.5.3",
    "rate-limit-redis": "^6.0.1",
    "swagger-ui-express": "^5.0.1",
    "validator": "^13.15.35",
    "web-push": "^3.6.7",
    "xss": "^1.0.15",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.21.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/validator": "^13.15.10",
    "@types/web-push": "^3.6.4",
    "cross-env": "10.1.0",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.0",
    "prisma": "7.9.1",
    "strip-comments": "^2.0.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "overrides": {
    "pm2": {
      "js-yaml": "4.3.1"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    },
    "prisma": {
      "mysql2": "3.22.0",
      "fast-uri": "3.1.6"
    }
  }
}
