{
  "name": "training-platform-backend",
  "version": "1.0.0",
  "description": "Backend for training management platform",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "prepare": "node scripts/setup-git-filters.js",
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "nodemon --watch src --ext ts --exec ts-node src/server.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^4.17.25",
    "@types/node": "^22.10.2",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.1.0",
    "eslint-plugin-import": "^2.32.0",
    "nodemon": "^3.1.0",
    "strip-comments": "^2.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}
