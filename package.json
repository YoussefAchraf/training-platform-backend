{
  "name": "training-platform-backend",
  "version": "1.0.0",
  "description": "Backend for training management platform",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "prepare": "node scripts/setup-git-filters.js",
    "build": "tsc && node -e \"const fs=require('fs'); fs.copyFileSync('src/infrastructure/database/schema.sql','dist/infrastructure/database/schema.sql'); fs.cpSync('src/docs/paths','dist/docs/paths',{recursive:true})\"",
    "start": "node dist/server.js",
    "dev": "nodemon --watch src --ext ts --exec ts-node src/server.ts",
    "db:migrate": "ts-node src/infrastructure/database/migrate.ts",
    "docs:export": "ts-node scripts/exportSwagger.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.1",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^9.0.3",
    "pg": "^8.11.5",
    "pm2": "^7.0.3",
    "qrcode": "^1.5.3",
    "rate-limit-redis": "^6.0.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.1.0",
    "eslint-plugin-import": "^2.32.0",
    "nodemon": "^3.1.0",
    "strip-comments": "^2.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}
