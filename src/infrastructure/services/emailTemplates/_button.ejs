<table role="presentation" cellpadding="0" cellspacing="0" style="margin:28px 0 8px;">
  <tr>
    <td style="border-radius:10px; background-color:#dc2626;">
      <a href="<%= url %>" target="_blank" style="display:inline-block; padding:14px 30px; font-family:'Inter', -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:15px; font-weight:600; color:#ffffff; text-decoration:none; border-radius:10px;">
        <%= label %>
      </a>
    </td>
  </tr>
</table>
<p style="margin:0 0 24px; font-family:'Inter', -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:12px; line-height:1.6; color:#a1a1aa; word-break:break-all;">
  Or copy this link into your browser: <a href="<%= url %>" style="color:#71717a;"><%= url %></a>
</p>
