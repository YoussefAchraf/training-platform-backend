<h1 style="margin:0 0 16px; font-family:'Inter', -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:22px; font-weight:700; color:#18181b; line-height:1.3;">
  Reset your password
</h1>
<p style="margin:0 0 12px; font-family:'Inter', -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:15px; line-height:1.6; color:#3f3f46;">
  Hi <%= firstname %>,
</p>
<p style="margin:0 0 4px; font-family:'Inter', -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:15px; line-height:1.6; color:#3f3f46;">
  An administrator started a password reset for your account. Use the button below to set a new password &mdash; this link works once and expires soon, so use it right away.
</p>
<%- include('_button', { url: resetUrl, label: 'Set a new password' }) %>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#fffbeb; border:1px solid #fde68a; border-radius:10px; margin-top:8px;">
  <tr>
    <td style="padding:14px 18px; font-family:'Inter', -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:13px; line-height:1.6; color:#b45309;">
      If you weren't expecting this, contact your administrator &mdash; your existing sessions have already been signed out as a precaution.
    </td>
  </tr>
</table>
