<h1 style="margin:0 0 16px; font-family:'Inter', -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:22px; font-weight:700; color:#18181b; line-height:1.3;">
  New signup pending approval
</h1>
<p style="margin:0 0 20px; font-family:'Inter', -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:15px; line-height:1.6; color:#3f3f46;">
  A new account request needs your review:
</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#fafafa; border:1px solid #e4e4e7; border-radius:10px; margin-bottom:8px;">
  <tr>
    <td style="padding:16px 20px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
        <tr>
          <td style="padding:4px 0; font-family:'Inter', -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:13px; color:#71717a; width:110px; vertical-align:top;">Name</td>
          <td style="padding:4px 0; font-family:'Inter', -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:13px; color:#18181b; font-weight:600;"><%= newUser.firstname %> <%= newUser.lastname %></td>
        </tr>
        <tr>
          <td style="padding:4px 0; font-family:'Inter', -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:13px; color:#71717a; width:110px; vertical-align:top;">Email</td>
          <td style="padding:4px 0; font-family:'Inter', -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:13px; color:#18181b; font-weight:600;"><%= newUser.email %></td>
        </tr>
        <tr>
          <td style="padding:4px 0; font-family:'Inter', -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:13px; color:#71717a; width:110px; vertical-align:top;">Requested role</td>
          <td style="padding:4px 0;">
            <span style="display:inline-block; font-family:'Inter', -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:12px; font-weight:600; color:#dc2626; background-color:#fef2f2; border:1px solid #fecaca; border-radius:9999px; padding:2px 10px;"><%= newUser.roleName %></span>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>

<%- include('_button', { url: approvalsUrl, label: 'Review pending approvals' }) %>
