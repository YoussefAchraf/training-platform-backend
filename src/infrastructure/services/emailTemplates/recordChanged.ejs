<h1 style="margin:0 0 16px; font-family:'Inter', -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:22px; font-weight:700; color:#18181b; line-height:1.3;">
  <%= entityType %> <%= verb %>
</h1>
<p style="margin:0 0 20px; font-family:'Inter', -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:15px; line-height:1.6; color:#3f3f46;">
  <strong style="color:#18181b;"><%= actor.firstname %> <%= actor.lastname %></strong> (<%= actor.email %>) just <%= verb %> a <%= entityType.toLowerCase() %><% if (label) { %>: <strong style="color:#18181b;"><%= label %></strong><% } %>.
</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#fafafa; border:1px solid #e4e4e7; border-radius:10px;">
  <tr>
    <td style="padding:16px 20px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
        <tr>
          <td style="padding:4px 0; font-family:'Inter', -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:13px; color:#71717a; width:80px; vertical-align:top;">Entity</td>
          <td style="padding:4px 0; font-family:'Inter', -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:13px; color:#18181b; font-weight:600;"><%= entityType %> #<%= entityId %></td>
        </tr>
        <tr>
          <td style="padding:4px 0; font-family:'Inter', -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:13px; color:#71717a; width:80px; vertical-align:top;">Action</td>
          <td style="padding:4px 0; font-family:'Inter', -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:13px; color:#18181b; font-weight:600; text-transform:capitalize;"><%= verb %></td>
        </tr>
      </table>
    </td>
  </tr>
</table>
