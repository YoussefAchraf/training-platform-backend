<h1 style="margin:0 0 16px; font-family:'Inter', -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:22px; font-weight:700; color:#18181b; line-height:1.3;">
  <%= isExpired ? 'Certification expired' : 'Certification expiring soon' %>
</h1>
<p style="margin:0 0 12px; font-family:'Inter', -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:15px; line-height:1.6; color:#3f3f46;">
  Hi <%= firstname %>,
</p>
<p style="margin:0 0 20px; font-family:'Inter', -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:15px; line-height:1.6; color:#3f3f46;">
  <% if (isExpired) { %>
    Your <strong style="color:#18181b;"><%= trainingName %></strong> certification expired on <strong style="color:#18181b;"><%= expiresAtFormatted %></strong>. You may not be eligible for assignment to deliver this training until it's renewed.
  <% } else { %>
    Your <strong style="color:#18181b;"><%= trainingName %></strong> certification expires on <strong style="color:#18181b;"><%= expiresAtFormatted %></strong>. Update your profile once it's renewed so Managers can keep assigning you with confidence.
  <% } %>
</p>
<%- include('_button', { url: profileUrl, label: 'Update my profile' }) %>
