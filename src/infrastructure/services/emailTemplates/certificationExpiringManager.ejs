<h1 style="margin:0 0 16px; font-family:'Inter', -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:22px; font-weight:700; color:#18181b; line-height:1.3;">
  <%= isExpired ? 'Instructor certification expired' : 'Instructor certification expiring soon' %>
</h1>
<p style="margin:0 0 20px; font-family:'Inter', -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:15px; line-height:1.6; color:#3f3f46;">
  <% if (isExpired) { %>
    <strong style="color:#18181b;"><%= instructorName %></strong>'s <strong style="color:#18181b;"><%= trainingName %></strong> certification expired on <strong style="color:#18181b;"><%= expiresAtFormatted %></strong>. They won't be assignable to this training until it's renewed.
  <% } else { %>
    <strong style="color:#18181b;"><%= instructorName %></strong>'s <strong style="color:#18181b;"><%= trainingName %></strong> certification expires on <strong style="color:#18181b;"><%= expiresAtFormatted %></strong>.
  <% } %>
</p>
<%- include('_button', { url: instructorsUrl, label: 'View instructors' }) %>
