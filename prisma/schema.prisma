generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
  // package.json has "type": "commonjs" - without this, the generator
  // defaults to ESM output (uses import.meta.url), which ts-jest's
  // CommonJS transform can't parse at all. Caught by actually running the
  // test suite after wiring Prisma into app.ts, not by assuming the
  // default was fine.
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}

model audit_log {
  id            Int      @id @default(autoincrement())
  actor_id      Int?
  action        String   @db.VarChar(40)
  entity_type   String   @db.VarChar(50)
  entity_id     Int
  before        Json?
  after         Json?
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  actor_deleted Boolean  @default(false)
  users         users?   @relation(fields: [actor_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([created_at], map: "idx_audit_log_created_at")
  @@index([entity_type, entity_id], map: "idx_audit_log_entity")
}

model calendar {
  id                Int               @id @default(autoincrement())
  session_id        Int
  event_date        DateTime          @db.Timestamptz(6)
  end_date          DateTime?         @db.Timestamptz(6)
  title             String            @db.VarChar(200)
  created_at        DateTime          @default(now()) @db.Timestamptz(6)
  training_sessions training_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model clients {
  id                Int                 @id @default(autoincrement())
  company_name      String              @db.VarChar(150)
  email             String?             @db.VarChar(150)
  phone             String?             @db.VarChar(30)
  country           String?             @db.VarChar(2)
  created_by        Int?
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at        DateTime            @default(now()) @db.Timestamptz(6)
  deleted_at        DateTime?           @db.Timestamptz(6)
  users             users?              @relation(fields: [created_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  training_sessions training_sessions[]

  @@index([id], map: "idx_clients_active", where: raw("(deleted_at IS NULL)"))
}

model feature_announcements {
  id                            Int                             @id @default(autoincrement())
  created_by                    Int?
  title                         String                          @db.VarChar(150)
  description                   String
  target_roles                  Json
  created_at                    DateTime                        @default(now()) @db.Timestamptz(6)
  users                         users?                          @relation(fields: [created_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  feature_announcement_ratings  feature_announcement_ratings[]

  @@index([created_at], map: "idx_feature_announcements_created_at")
}

model feature_announcement_ratings {
  id                     Int                    @id @default(autoincrement())
  announcement_id        Int
  user_id                Int
  stars                  Int
  created_at             DateTime               @default(now()) @db.Timestamptz(6)
  feature_announcements  feature_announcements  @relation(fields: [announcement_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                  users                  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([announcement_id, user_id])
  @@index([announcement_id], map: "idx_feature_announcement_ratings_announcement")
}

model feedback_reports {
  id            Int               @id @default(autoincrement())
  submitted_by  Int?
  category      feedback_category
  message       String
  created_at    DateTime          @default(now()) @db.Timestamptz(6)
  users         users?            @relation(fields: [submitted_by], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([submitted_by], map: "idx_feedback_reports_submitted_by")
  @@index([created_at], map: "idx_feedback_reports_created_at")
}

model instructor_skills {
  instructor_id           Int
  training_id             Int
  certificate_id          String?
  certificate_expires_at  DateTime?   @db.Timestamptz(6)
  expiry_reminder_sent_at DateTime?   @db.Timestamptz(6)
  instructors             instructors @relation(fields: [instructor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  trainings               trainings   @relation(fields: [training_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([instructor_id, training_id])
}

model instructors {
  id                Int                 @id @default(autoincrement())
  user_id           Int                 @unique
  bio               String?
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at        DateTime            @default(now()) @db.Timestamptz(6)
  instructor_skills instructor_skills[]
  users             users               @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  surveys           surveys[]
  training_sessions training_sessions[]
  session_notes     session_notes[]
}

model conversations {
  id         Int               @id @default(autoincrement())
  type       conversation_type
  name       String?           @db.VarChar(150)
  created_by Int?
  created_at DateTime          @default(now()) @db.Timestamptz(6)

  creator      users?                      @relation(fields: [created_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  participants conversation_participants[]
  messages     messages[]

  @@index([created_by], map: "idx_conversations_created_by")
}

model conversation_participants {
  conversation_id           Int
  user_id                   Int
  role                      conversation_role @default(member)
  joined_at                 DateTime          @default(now()) @db.Timestamptz(6)
  last_read_message_id      Int?
  last_read_at              DateTime?         @db.Timestamptz(6)
  last_delivered_message_id Int?
  last_delivered_at         DateTime?         @db.Timestamptz(6)
  hidden_at                 DateTime?         @db.Timestamptz(6)
  muted_at                  DateTime?         @db.Timestamptz(6)

  conversations          conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                  users         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  last_read_message      messages?     @relation("participant_last_read", fields: [last_read_message_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  last_delivered_message messages?     @relation("participant_last_delivered", fields: [last_delivered_message_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@id([conversation_id, user_id])
  @@index([user_id], map: "idx_conversation_participants_user")
}

model messages {
  id                          Int          @id @default(autoincrement())
  conversation_id             Int
  sender_id                   Int?
  type                        message_type
  body                        String?      @db.Text
  attachment_key              String?
  attachment_original_name    String?
  attachment_mime             String?
  attachment_size_bytes       Int?
  attachment_duration_seconds Int?
  reply_to_message_id         Int?
  created_at                  DateTime     @default(now()) @db.Timestamptz(6)
  edited_at                   DateTime?    @db.Timestamptz(6)
  deleted_at                  DateTime?    @db.Timestamptz(6)

  conversations     conversations               @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sender            users?                      @relation(fields: [sender_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  reply_to          messages?                   @relation("messagesTomessages", fields: [reply_to_message_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  replies           messages[]                  @relation("messagesTomessages")
  read_markers      conversation_participants[] @relation("participant_last_read")
  delivered_markers conversation_participants[] @relation("participant_last_delivered")
  message_deletions message_deletions[]

  @@index([conversation_id, id], map: "idx_messages_conversation_id_id")
  @@index([sender_id], map: "idx_messages_sender")
}

model message_deletions {
  message_id Int
  user_id    Int
  deleted_at DateTime @default(now()) @db.Timestamptz(6)

  messages messages @relation(fields: [message_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users    users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([message_id, user_id])
  @@index([user_id], map: "idx_message_deletions_user")
}

model providers {
  id          Int         @id @default(autoincrement())
  name        String      @unique(map: "idx_providers_name_active", where: raw("(deleted_at IS NULL)")) @db.VarChar(150)
  description String?
  created_by  Int?
  created_at  DateTime    @default(now()) @db.Timestamptz(6)
  updated_at  DateTime    @default(now()) @db.Timestamptz(6)
  deleted_at  DateTime?   @db.Timestamptz(6)
  logo_url    String?     @db.VarChar(500)
  users       users?      @relation(fields: [created_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  trainings   trainings[]

  @@index([id], map: "idx_providers_active", where: raw("(deleted_at IS NULL)"))
}

model push_subscriptions {
  id         Int      @id @default(autoincrement())
  user_id    Int
  endpoint   String
  p256dh     String
  auth       String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, endpoint], map: "push_subscriptions_user_id_endpoint_key")
  @@index([user_id], map: "idx_push_subscriptions_user")
  @@index([endpoint], map: "idx_push_subscriptions_endpoint")
}

model reports {
  id                Int               @id @default(autoincrement())
  session_id        Int               @unique
  pdf_url           String?           @db.VarChar(255)
  average_score     Decimal?          @db.Decimal(4, 2)
  nps_average       Decimal?          @db.Decimal(5, 2)
  generated_at      DateTime          @default(now()) @db.Timestamptz(6)
  training_sessions training_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model session_notes {
  id                Int               @id @default(autoincrement())
  session_id        Int
  instructor_id     Int
  body              String
  created_at        DateTime          @default(now()) @db.Timestamptz(6)
  updated_at        DateTime          @default(now()) @db.Timestamptz(6)
  training_sessions training_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  instructors       instructors       @relation(fields: [instructor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([session_id], map: "idx_session_notes_session_id")
}

model roles {
  id    Int     @id @default(autoincrement())
  name  String  @unique @db.VarChar(50)
  users users[]
}

model session_attendees {
  id                 Int                @id @default(autoincrement())
  session_id         Int
  name               String             @db.VarChar(150)
  email              String?            @db.VarChar(150)
  survey_submitted   Boolean            @default(false)
  attendance_status  attendance_status  @default(pending)
  created_at         DateTime           @default(now()) @db.Timestamptz(6)
  training_sessions  training_sessions  @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  surveys            surveys[]

  @@index([session_id], map: "idx_attendees_session")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model surveys {
  id                Int                @id @default(autoincrement())
  session_id        Int
  instructor_id     Int?
  attendee_id       Int?
  instructor_score  Int
  nps_score         Int
  comments          String?
  submitted_at      DateTime           @default(now()) @db.Timestamptz(6)
  session_attendees session_attendees? @relation(fields: [attendee_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  instructors       instructors?       @relation(fields: [instructor_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  training_sessions training_sessions  @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([session_id], map: "idx_surveys_session")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model training_sessions {
  id                Int                 @id @default(autoincrement())
  training_id       Int
  client_id         Int
  instructor_id     Int?
  start_date        DateTime            @db.Timestamptz(6)
  end_date          DateTime            @db.Timestamptz(6)
  session_status    session_status      @default(scheduled)
  assignment_status assignment_status   @default(unassigned)
  include_weekends  Boolean             @default(false)
  location_type     session_location_type @default(onsite)
  teaching_language session_teaching_language @default(french)
  created_by        Int?
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at        DateTime            @default(now()) @db.Timestamptz(6)
  reminder_24h_sent_at DateTime?        @db.Timestamptz(6)
  reminder_1h_sent_at  DateTime?        @db.Timestamptz(6)
  calendar          calendar[]
  reports           reports?
  session_attendees session_attendees[]
  session_notes     session_notes[]
  surveys           surveys[]
  clients           clients             @relation(fields: [client_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users             users?              @relation(fields: [created_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  instructors       instructors?        @relation(fields: [instructor_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  trainings         trainings           @relation(fields: [training_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([instructor_id], map: "idx_sessions_instructor")
  @@index([session_status], map: "idx_sessions_status")
  @@index([start_date], map: "idx_sessions_start_date")
}

model trainings {
  id                Int                     @id @default(autoincrement())
  name              String                  @db.VarChar(150)
  provider_id       Int
  description       String?
  duration          Int?
  duration_unit     training_duration_unit?
  created_by        Int?
  created_at        DateTime                @default(now()) @db.Timestamptz(6)
  updated_at        DateTime                @default(now()) @db.Timestamptz(6)
  deleted_at        DateTime?               @db.Timestamptz(6)
  instructor_skills instructor_skills[]
  training_sessions training_sessions[]
  users             users?                  @relation(fields: [created_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  providers         providers               @relation(fields: [provider_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([id], map: "idx_trainings_active", where: raw("(deleted_at IS NULL)"))
}

model users {
  id                 Int                  @id @default(autoincrement())
  firstname          String               @db.VarChar(100)
  lastname           String               @db.VarChar(100)
  email              String               @unique @db.VarChar(150)
  password_hash      String               @db.VarChar(255)
  role_id            Int
  status             user_status          @default(pending)
  approved_by        Int?
  approved_at        DateTime?            @db.Timestamptz(6)
  has_seen_tour      Boolean              @default(false)
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime             @default(now()) @db.Timestamptz(6)
  audit_log          audit_log[]
  clients            clients[]
  feature_announcements         feature_announcements[]
  feature_announcement_ratings  feature_announcement_ratings[]
  feedback_reports   feedback_reports[]
  instructors        instructors?
  providers          providers[]
  push_subscriptions push_subscriptions[]
  training_sessions  training_sessions[]
  trainings          trainings[]
  conversations              conversations[]
  conversation_participants  conversation_participants[]
  messages                   messages[]
  message_deletions          message_deletions[]
  users              users?               @relation("usersTousers", fields: [approved_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  other_users        users[]              @relation("usersTousers")
  roles              roles                @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

enum assignment_status {
  unassigned
  pending
  accepted
  refused
}

enum attendance_status {
  pending
  present
  absent
}

enum feedback_category {
  bug
  enhancement
  other
}

enum session_status {
  scheduled
  ongoing
  completed
  cancelled
}

enum session_location_type {
  onsite
  remote
}

enum session_teaching_language {
  french
  english
}

enum training_duration_unit {
  days
  hours
}

enum user_status {
  pending
  approved
  rejected
  deactivated
}

enum conversation_type {
  direct
  group
}

enum conversation_role {
  owner
  member
}

enum message_type {
  text
  image
  voice
  file
}
